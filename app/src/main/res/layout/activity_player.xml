<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    tools:context=".PlayerActivity">

    <!-- 1. KHU VỰC PHÁT VIDEO CHUẨN YOUTUBE/NETFLIX (Chỉ hiện Controller khi User Tap vào màn hình) -->
    <LinearLayout
        android:id="@+id/webPlayerActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Button android:id="@+id/btnWebBack" android:layout_width="wrap_content"
            android:layout_height="48dp" android:text="Đóng" android:textAllCaps="false" />
        <Space android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <ImageButton android:id="@+id/btnWebPip" android:layout_width="48dp"
            android:layout_height="48dp" android:src="@drawable/ic_pip"
            android:contentDescription="Thu nhỏ PiP" android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp" app:tint="@android:color/white" />
        <ImageButton android:id="@+id/btnWebFullscreen" android:layout_width="48dp"
            android:layout_height="48dp" android:src="@drawable/ic_fullscreen"
            android:contentDescription="Toàn màn hình" android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp" app:tint="@android:color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/framePlayerContainer"
        android:layout_width="0dp"
        android:layout_height="250dp"
        android:background="@android:color/black"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/webPlayerActions">

        <!-- PlayerView Media3 sử dụng Controller Custom exo_playback_control_view (YouTube/Netflix Tap-to-Show) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:controller_layout_id="@layout/exo_playback_control_view"
            app:keep_content_on_player_reset="true"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <WebView
            android:id="@+id/wvYouTubePlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Spinner báo đang đệm (buffering) cho ExoPlayer -->
        <ProgressBar
            android:id="@+id/progressBuffering"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:indeterminateTint="#E50914"
            android:visibility="gone" />

        <!-- TOP BAR: gradient + thông tin tiêu đề và nút thoát -->
        <RelativeLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_gradient_top_down"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnExitPlayer"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:contentDescription="Thoát Video"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/tvPlayerVideoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Tên phim đang phát..." />

                <TextView
                    android:id="@+id/tvQualityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_quality"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="AUTO"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnDownloadVideo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:contentDescription="Tải video phim"
                    android:padding="8dp"
                    android:src="@drawable/ic_download"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnPip"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:contentDescription="Thu nhỏ PiP"
                    android:padding="8dp"
                    android:src="@drawable/ic_pip"
                    app:tint="@android:color/white" />

            </LinearLayout>
        </RelativeLayout>

    </FrameLayout>

    <!-- 2. THÔNG TIN PHIM -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMovieDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/framePlayerContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_badge_quality" />

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@android:color/white"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    tools:text="Big Buck Bunny 4K" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#1A1A26"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:textColor="#E50914"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="🏷️ Thể loại: Hoạt Hình, Hài Hước, Phiêu Lưu" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#23232F" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NỘI DUNG PHIM"
                android:textColor="#888899"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvDetailDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp"
                android:textColor="#D5D5DE"
                android:textSize="14sp"
                tools:text="Nội dung mô tả chi tiết của phim sẽ được hiển thị đầy đủ tại đây..." />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
