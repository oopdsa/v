<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".PlayerActivity">

    <!-- Trình phát video Media3 ExoPlayer PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:use_controller="true"
        app:resize_mode="fit"
        app:show_fastforward_button="false"
        app:show_rewind_button="false"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- WebView trình phát video YouTube IFrame -->
    <WebView
        android:id="@+id/wvYouTubePlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Thanh Điều Khiển Phía Trên (Top Control Bar) -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#A0000000"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút Thoát / Đóng Màn Hình Video -->
        <ImageButton
            android:id="@+id/btnExitPlayer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thoát Video"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@android:color/white" />

        <!-- Tiêu đề Video / Phim đang phát -->
        <TextView
            android:id="@+id/tvPlayerVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_toEndOf="@id/btnExitPlayer"
            android:layout_toStartOf="@id/btnDownloadVideo"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Tên phim đang phát..." />

        <!-- Nút Tải Video Phim về máy -->
        <ImageButton
            android:id="@+id/btnDownloadVideo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnPip"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tải video phim"
            android:padding="8dp"
            android:src="@drawable/ic_download"
            app:tint="@android:color/white" />

        <!-- Nút Bật Chế Độ PiP (Picture-in-Picture) -->
        <ImageButton
            android:id="@+id/btnPip"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnQuality"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thu nhỏ PiP"
            android:padding="8dp"
            android:src="@drawable/ic_pip"
            app:tint="@android:color/white" />

        <!-- Nút Chỉnh Độ Phân Giải Video (Quality / Resolution Button) -->
        <ImageButton
            android:id="@+id/btnQuality"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chỉnh độ phân giải"
            android:padding="8dp"
            android:src="@drawable/ic_quality"
            app:tint="@android:color/white" />

    </RelativeLayout>

    <!-- Khung Nút Tua Nhanh (-10s) và Tua Lùi (+10s) Đặt Ngang Hàng Với Nút Play/Pause Nằm Ở Giữa -->
    <LinearLayout
        android:id="@+id/layoutSeekControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút Tua Lùi 10 Giây (-10s) bên trái nút Play/Pause -->
        <ImageButton
            android:id="@+id/btnRewind10"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="56dp"
            android:background="#80000000"
            android:contentDescription="Tua lùi 10 giây"
            android:padding="11dp"
            android:src="@drawable/ic_rewind_10"
            app:tint="@android:color/white" />

        <!-- Nút Tua Tới 10 Giây (+10s) bên phải nút Play/Pause -->
        <ImageButton
            android:id="@+id/btnForward10"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="56dp"
            android:background="#80000000"
            android:contentDescription="Tua tới 10 giây"
            android:padding="11dp"
            android:src="@drawable/ic_forward_10"
            app:tint="@android:color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
