<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#181822">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 1. KHU VỰC PHÁT TRAILER XEM TRƯỚC (TRAILER PREVIEW PLAYER) -->
        <FrameLayout
            android:id="@+id/framePlayerPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@android:color/black">

            <!-- PlayerView cho Trailer MP4/HLS -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/playerViewPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:resize_mode="fit"
                app:use_controller="false" />

            <!-- WebView cho Trailer YouTube -->
            <WebView
                android:id="@+id/wvYouTubePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Nút Đóng Modal Sheet (X) -->
            <ImageButton
                android:id="@+id/btnCloseDetail"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="#A0000000"
                android:contentDescription="Đóng"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                app:tint="@android:color/white" />

            <!-- Nhãn Badge "Bản xem trước" (Trailer Preview) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="#CC000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="Bản xem trước"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- 2. THÔNG TIN VÀ META BADGES CHUẨN SƠ ĐỒ NETFLIX -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- Tên Phim Đang Chọn -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Tên Phim Đang Chọn" />

            <!-- Dải Thông Số Meta Badges: Độ phù hợp, Năm, 16+, Số Tập/Mùa, HD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMatchScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Độ phù hợp 98%"
                    android:textColor="#4CAF50"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReleaseYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    tools:text="2024" />

                <TextView
                    android:id="@+id/tvAgeRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="#2E2E3A"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="16+"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSeasonsOrEpisodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    tools:text="2 Mùa / 6 Tập" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="#2E2E3A"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="HD"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- 3. NÚT PHÁT CHÍNH (TO MÀU TRẮNG PHÁT PHIM / TẬP 1) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayMovie"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@android:color/white"
                android:text="▶  Phát"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="6dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchTrailer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Xem trailer"
                android:textAllCaps="false"
                android:textColor="#F2F2F7" />

            <!-- 4. KHU VỰC CÁC TẬP PHIM (EPISODE SELECTOR BUTTONS: Tập 1, Tập 2, Tập 3...) -->
            <LinearLayout
                android:id="@+id/layoutEpisodesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="DANH SÁCH TẬP PHIM"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutEpisodesContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- 5. ĐOẠN MÔ TẢ TÓM TẮT PHIM -->
            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"
                android:textColor="#DDDDDD"
                android:textSize="13sp"
                tools:text="Đây là đoạn tóm tắt nội dung của bộ phim. Một nhóm bạn trẻ phát hiện ra những bí mật kinh hoàng được giấu kín..." />

            <!-- 6. THANH HÀNH ĐỘNG DƯỚI CÙNG (+ Danh sách, 👍 Đánh giá, ✈️ Chia sẻ) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- + Danh sách -->
                <LinearLayout
                    android:id="@+id/btnMyList"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="My List"
                        android:src="@drawable/ic_add"
                        app:tint="@android:color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Danh sách"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 👍 Đánh giá -->
                <LinearLayout
                    android:id="@+id/btnRate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👍"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Đánh giá"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- ✈️ Chia sẻ -->
                <LinearLayout
                    android:id="@+id/btnShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chia sẻ"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
