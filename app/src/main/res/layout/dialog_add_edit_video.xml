<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề Dialog Admin -->
        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="Thêm Video Mới"
            android:textColor="#E50914"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 1. CARD 1: THÔNG TIN PHIM CƠ BẢN (Tên, Mô tả, Năm, Tháng, Loại Phim) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="📝 Thông Tin Phim"
                    android:textColor="#181818"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Tên Phim / Tiêu đề -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Tên Phim / Tiêu đề">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDialogTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Ô nhập Mô tả video -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Mô tả video">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDialogDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="3" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Hàng Ô Nhập Năm & Tháng Phát Hành -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="Năm Phát Hành">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDialogYear"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="2024" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="Tháng Phát Hành">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDialogMonth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="10" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Chọn Loại Video: Phim Chiếu Rạp/Series vs Trailer Preview -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Loại Phim / Video:"
                    android:textColor="#B9B9C7"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgVideoType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTypeStandard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:checked="true"
                        android:text="Phim Chiếu Rạp / Series"
                        android:textSize="12sp" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbTypeTrailer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trailer Xem Trước"
                        android:textSize="12sp" />

                </RadioGroup>

                <!-- CheckBox chọn Phim Nổi Bật (Popular Slider) -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbIsPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⭐ Thêm vào Phim Nổi Bật (Popular Slider)"
                    android:textColor="#F2F2F7"
                    android:textSize="13sp"
                    app:buttonTint="#E50914" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. CARD 2: QUẢN LÝ THỂ LOẠI PHIM (GENRES) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSelectedGenres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="#2424BD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="🏷️ Thể loại đã chọn: Hành Động, Kinh Dị" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectGenres"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="🏷️ Chọn Thể Loại"
                        android:textSize="11sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageGenres"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="⚙️ Tạo / Xóa Thể Loại"
                        android:textColor="#E50914"
                        android:textSize="11sp"
                        app:strokeColor="#E50914" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. CARD 3: QUẢN LÝ CÁC TẬP PHIM (EPISODES MANAGER) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvEpisodesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="#F2F2F7"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="📺 Danh sách Tập: Tập 1, Tập 2, Tập 3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageEpisodes"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📺 Quản Lý Các Tập Phim (Episodes)"
                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    app:strokeColor="#2E7D32" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. CARD 4: NGUỒN VIDEO GỐC (VIDEO SOURCE & UPLOAD) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🎬 Nguồn Video Gốc / Trailer (Link / Upload)"
                    android:textColor="#F2F2F7"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Đường dẫn Video (YouTube / MP4 / HLS .m3u8) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="URL Video Gốc (HLS .m3u8 / MP4 / YouTube)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDialogVideoUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nút Chọn & Upload Video từ thiết bị lên Cloudinary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📁 Chọn &amp; Upload File Video từ máy"
                    android:textColor="@color/design_default_color_primary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/design_default_color_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. CARD 5: QUẢN LÝ DUB BẮT MẮT (Multi-Audio Tracks Admin) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvAudioTracksSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="#F2F2F7"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="🎙️ Luồng lồng tiếng (Dub): Tiếng Việt, English, Japanese" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageAudioTracks"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Quản Lý Luồng Lồng Tiếng (Dubbing)"
                    android:textColor="#3700B3"
                    android:textSize="12sp"
                    app:strokeColor="#3700B3" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. CARD 6: QUẢN LÝ SUB BẮT MẮT (Multi-Subtitles CC Admin) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSubtitlesSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:textColor="#F2F2F7"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="💬 Phụ đề rời CC: Tiếng Việt (.vtt), English (.vtt)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageSubtitles"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💬 Quản Lý Phụ Đề Rời (Subtitles CC)"
                    android:textColor="#E50914"
                    android:textSize="12sp"
                    app:strokeColor="#E50914" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. CARD 7: QUẢN LÝ ẢNH BÌA / THUMBNAIL PNG (THUMBNAIL IMAGE & UPLOAD) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1B1B28"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="🖼️ Ảnh Bìa / Poster Phim (PNG / JPG)"
                    android:textColor="#F2F2F7"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Đường dẫn Ảnh Bìa (Tùy chọn) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="URL Ảnh Bìa / Poster PNG, JPG">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDialogThumbnailUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nút Chọn & Upload Ảnh Bìa từ thiết bị lên Cloudinary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Chọn &amp; Upload Ảnh từ máy"
                    android:textColor="@color/design_default_color_primary"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_add"
                    app:iconTint="@color/design_default_color_primary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
