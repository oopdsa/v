<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Thêm Video Mới"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Tên Phim / Tiêu đề -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Tên Phim / Tiêu đề">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ô nhập Mô tả video -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Mô tả video">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="3" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Chọn Thể Loại Phim (Genres) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSelectedGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="#333333"
            android:textSize="13sp"
            tools:text="Thể loại đã chọn: Hành Động, Kinh Dị" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectGenres"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="🏷️ Chọn Thể Loại"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageGenres"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="⚙️ Tạo / Xóa Thể Loại"
                android:textColor="#E50914"
                android:textSize="12sp"
                app:strokeColor="#E50914" />

        </LinearLayout>

    </LinearLayout>

    <!-- CheckBox chọn Phim Nổi Bật (Popular Slider) -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbIsPopular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="⭐ Thêm vào danh sách Phim Nổi Bật (Popular Slider)"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:buttonTint="#E50914" />

    <!-- Đường dẫn Video (YouTube / MP4) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="URL Video (YouTube hoặc MP4)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogVideoUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nút Chọn & Upload Video từ thiết bị lên Cloudinary -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickVideo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="📁 Chọn &amp; Upload Video từ máy"
        android:textColor="@color/design_default_color_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/design_default_color_primary" />

    <!-- Đường dẫn Ảnh Bìa (Tùy chọn) -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="URL Ảnh Bìa / Thumbnail (Tùy chọn)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDialogThumbnailUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nút Chọn & Upload Ảnh Bìa từ thiết bị lên Cloudinary -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickImage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="🖼️ Chọn &amp; Upload Ảnh từ máy"
        android:textColor="@color/design_default_color_primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/design_default_color_primary" />

</LinearLayout>
