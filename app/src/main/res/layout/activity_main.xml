<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- AppBarLayout giữ nguyên màu đen #121212 khi cuộn xuống -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- HEADER TRÊN CÙNG: Logo, Nút Chuyển View, Tìm Kiếm, Admin -->
        <RelativeLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:background="#E50914" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="PGCK2 CINEMA"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Nút Đổi Chế Độ Admin -->
            <ImageButton
                android:id="@+id/btnToggleAdmin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Chế độ Admin"
                android:padding="8dp"
                android:src="@drawable/ic_admin"
                app:tint="@android:color/white" />

            <!-- Nút Bật/Tắt Tìm Kiếm -->
            <ImageButton
                android:id="@+id/btnToggleSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:layout_toStartOf="@id/btnToggleAdmin"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tìm kiếm"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@android:color/white" />

            <!-- Nút Chuyển Chế Độ Xem (Default vs All) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleViewMode"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:layout_toStartOf="@id/btnToggleSearch"
                android:paddingHorizontal="10dp"
                android:text="Mặc Định"
                android:textColor="#E50914"
                android:textSize="12sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- THANH TÌM KIẾM & BỘ LỌC THỂ LOẠI LƯỚI GRID 3 CỘT (ĐÚNG SƠ ĐỒ) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="#181824"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:strokeColor="#2E2E42"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- 1. Thanh Ô Nhập Tìm Kiếm Từ Khóa (Yellow Search Bar) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search Icon"
                        android:src="@drawable/ic_search"
                        app:tint="#E50914" />

                    <EditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Tìm theo tên hoặc mô tả phim..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="8dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="#777777"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear Text"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        app:tint="#888888" />
                </LinearLayout>

                <!-- Line phân cách mờ -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#2E2E3E" />

                <!-- 2. Header Lọc Thể Loại & Nút Đặt Lại -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvFilterInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="LỌC THỂ LOẠI (Bật ➔ ✓ Bắt buộc | ✕ Cấm)"
                        android:textColor="#BBBBBB"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResetFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Đặt lại"
                        android:textColor="#E50914"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- 3. Danh Sách Thể Loại Xếp Thành Các Hàng Dọc (Flexbox Grid 3 Cột Chuẩn Sơ Đồ) -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupGenresFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="6dp"
                    app:singleLine="false"
                    app:singleSelection="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- NỘI DUNG CHÍNH (CUỘN ĐƯỢC) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 1. KHU VỰC "POPULAR" (SLIDER NỔI BẬT) -->
            <RelativeLayout
                android:id="@+id/layoutPopularSlider"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/viewPagerPopular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </RelativeLayout>

            <!-- 2. SECTION HEADER 1: RECENTLY ADDED (TOP 10) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#E50914" />

                    <TextView
                        android:id="@+id/tvSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mới cập nhật"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nút chuyển sang xem Tất Cả / Phim Mới -->
                <TextView
                    android:id="@+id/btnSwitchViewMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:text="Xem tất cả ➔"
                    android:textColor="#E50914"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- 3. DANH SÁCH PHIM RECYCLERVIEW (Ngang Top 10 hoặc Lưới 3 Cột 18 Phim/Trang) -->

            <!-- 4. SECTION HEADER 2: TOP 10 PHIM TRONG THÁNG (HARDCODE DEMO URL) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVideos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                tools:listitem="@layout/item_video_horizontal" />

            <RelativeLayout
                android:id="@+id/layoutTop10MonthHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:background="#E50914" />

                    <TextView
                        android:id="@+id/tvTop10MonthTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top 10 Phim Trong Tháng 🔥"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </RelativeLayout>

            <!-- 5. DANH SÁCH TOP 10 PHIM TRONG THÁNG (RECYCLERVIEW NGANG DEMO) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTop10Month"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="8dp"
                tools:listitem="@layout/item_video_horizontal" />

            <!-- 6. THANH PHÂN TRANG CHO CHẾ ĐỘ XEM TẤT CẢ (LƯỚI 3 CỘT, 18 PHIM / TRANG) -->
            <LinearLayout
                android:id="@+id/layoutPagination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevPage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◄ Trước"
                    android:textColor="#E50914"
                    android:textSize="12sp"
                    app:strokeColor="#E50914" />

                <TextView
                    android:id="@+id/tvPageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Trang 1 / 3 (1-18)" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextPage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sau ►"
                    android:textColor="#E50914"
                    android:textSize="12sp"
                    app:strokeColor="#E50914" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Nút Thêm Video mới (Red Accent Floating Action Button cho Admin) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Thêm Video mới"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:backgroundTint="#E50914"
        app:tint="@android:color/white"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
