<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    app:cardBackgroundColor="#1A1A24"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    app:strokeColor="#2A2A38"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Khung Poster Ảnh Cố Định 140dp cho Lưới 3 Cột -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/imgThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Video Poster"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Lớp phủ mờ chân poster -->
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_alignParentBottom="true"
                android:background="#80000000" />

            <!-- Biểu tượng Play chính giữa poster -->
            <ImageView
                android:id="@+id/imgPlayBadge"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerInParent="true"
                android:background="#B0000000"
                android:contentDescription="Play Icon"
                android:padding="5dp"
                android:src="@android:drawable/ic_media_play"
                app:tint="@android:color/white" />

            <!-- Khung nút Admin Sửa/Xóa nhỏ góc trên -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="2dp"
                android:background="#B0000000"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btnEditVideo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Sửa Video"
                    android:padding="2dp"
                    android:src="@drawable/ic_edit"
                    app:tint="#4CAF50" />

                <ImageButton
                    android:id="@+id/btnDeleteVideo"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Xóa Video"
                    android:padding="2dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#FF5252" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Thông Tin Tiêu Đề & Thể Loại bên dưới Ảnh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="5dp"
            android:paddingTop="5dp"
            android:paddingBottom="6dp">

            <!-- Tiêu Đề (Chuẩn 2 dòng đều đặn cho mọi card trong lưới 3 cột) -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:minLines="2"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Tên phim dài hai dòng đầy đủ..." />

            <!-- Thể Loại (1 dòng màu đỏ accent) -->
            <TextView
                android:id="@+id/tvGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E50914"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="🏷️ Hành Động" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
